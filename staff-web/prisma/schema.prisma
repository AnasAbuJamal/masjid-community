enum MembershipStatus {
  active
  suspended
  left
}
enum RoleCapability {
  worship_publish
  facilities_manage
  volunteers_manage
  community_moderate
  care_manage
}
// Invitations are not authority. The recipient must verify the exact email,
// enroll MFA and explicitly accept before any scoped grant exists.
model StaffInvitation {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  invitedEmail String
  tokenHash String @unique
  capabilities RoleCapability[]
  issuedById String
  issuer User @relation("StaffInvitationIssuer",fields:[issuedById],references:[id],onDelete:Restrict)
  acceptedUserId String?
  accepter User? @relation("StaffInvitationAccepter",fields:[acceptedUserId],references:[id],onDelete:Restrict)
  acceptedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([organizationId,invitedEmail,expiresAt])
  @@index([organizationId,createdAt])
}
model OrganizationMembership {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  status MembershipStatus @default(active)
  joinedAt DateTime @default(now())
  grants RoleGrant[]
  @@unique([organizationId,userId])
  @@index([userId,status])
}
model RoleGrant {
  id String @id @default(cuid())
  membershipId String
  membership OrganizationMembership @relation(fields:[membershipId],references:[id])
  capability RoleCapability
  grantedById String
  grantedBy User @relation(fields:[grantedById],references:[id])
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  @@unique([membershipId,capability])
  @@index([membershipId,revokedAt,expiresAt])
}

enum OutboxStatus {
  pending
  leased
  delivered
  retry
  exhausted
}
model OutboxEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  notificationId String
  notification Notification @relation(fields:[notificationId],references:[id])
  channel String @default("email")
  status OutboxStatus @default(pending)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  lastErrorCode String?
  providerMessageId String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@unique([notificationId,channel])
  @@index([status,availableAt,leaseUntil])
}
