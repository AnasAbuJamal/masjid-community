generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
member
teacher
staff
finance
admin
student
}
enum AccountStatus {
active
suspended
disabled
}
enum ContentStatus {
draft
published
archived
}
enum ApplicationStatus {
submitted
approved
declined
withdrawn
}

enum CircleMemberStatus {
  requested
  approved
  declined
  left
}

enum SchoolWaitlistStatus {
  waiting
  promoted
  cancelled
}
enum PaymentStatus {
pending
paid
failed
refunded
}
enum BookingStatus {
requested
approved
cancelled
rejected
}
enum AttendanceStatus {
present
absent
late
excused
}

model Organization {
  id String @id @default(cuid())
  slug String @unique
  name String
  timeZone String @default("America/New_York")
  address String?
  createdAt DateTime @default(now())
  venues Venue[]
  announcements Announcement[]
  events Event[]
  circles Circle[]
  programs SchoolProgram[]
  students Student[]
  campaigns DonationCampaign[]
  proposals Proposal[]
  rentals RentalResource[]
  opportunities VolunteerOpportunity[]
  jobs JobPosting[]
  contactRequests ContactSubmission[]
  careRequests CareRequest[]
  articles CommunityArticle[]
  constructionProjects ConstructionProject[]
  budgets FinanceBudget[]
  expenses FinanceExpense[]
  invoices SchoolInvoice[]
  ledgerAccounts LedgerAccount[]
  journals JournalEntry[]
  refundRequests RefundRequest[]
  payouts ProviderPayout[]
  faithNotices FaithNotice[]
  memberships OrganizationMembership[]
  staffInvitations StaffInvitation[]
  deletionRequests DeletionRequest[]
  notifications Notification[]
}
model Venue {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  name String
  address String?
  timeZone String @default("America/New_York")
  prayerDays PrayerDay[]
  prayerRevisions PrayerScheduleRevision[]
  jummahSessions JummahSession[]
  @@index([organizationId])
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  status AccountStatus @default(active)
  role UserRole @default(member)
  verifiedAt DateTime?
  mfaSecretEncrypted String?
  mfaPendingSecretEncrypted String?
  mfaEnabledAt DateTime?
  mfaLastCounter Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AuthSession[]
  emailTokens EmailToken[]
  resetTokens PasswordResetToken[]
  rsvps EventRSVP[]
  hostedEvents EventHostAssignment[]
  hostedCircles Circle[] @relation("CircleHost")
  circleMemberships CircleMember[]
  circleUpdates CircleUpdate[] @relation("CircleUpdateAuthor")
  careRequests CareRequest[] @relation("CareRequester")
  careAssignments CareCaseAccess[] @relation("CareAssignee")
  volunteerApplications VolunteerApplication[]
  studentAccount Student? @relation("StudentAccount")
  guardianLinks GuardianLink[]
  teacherAssignments TeacherAssignment[]
  donations Donation[]
  votes ProposalVote[]
  jobApplications JobApplication[]
  bookings RentalBooking[]
  notifications Notification[]
  outboxEvents OutboxEvent[]
  auditEvents AuditEvent[]
  payoutReviewNotes PayoutReviewNote[]
  invitationsIssued StaffInvitation[] @relation("StaffInvitationIssuer")
  invitationsAccepted StaffInvitation[] @relation("StaffInvitationAccepter")
  authoredAssignments SchoolAssignment[] @relation("AssignmentAuthor")
  authoredReports StudentReport[] @relation("ReportAuthor")
  submittedProposals Proposal[] @relation("ProposalSubmitter")
  expensesSubmitted FinanceExpense[] @relation("ExpenseSubmitter")
  expensesApproved FinanceExpense[] @relation("ExpenseApprover")
  enrollmentApplications EnrollmentApplication[] @relation("ApplicationParent")
  reviewedApplications EnrollmentApplication[] @relation("ApplicationReviewer")
  preferences UserPreference?
  deletionRequests DeletionRequest[] @relation("DeletionSubject")
  reviewedDeletions DeletionRequest[] @relation("DeletionReviewer")
  volunteerShifts VolunteerShift[]
  refundsSubmitted RefundRequest[] @relation("RefundRequester")
  refundsReviewed RefundRequest[] @relation("RefundReviewer")
  approvedFaithNotices FaithNotice[]
  memberships OrganizationMembership[]
  grantedRoles RoleGrant[]
}
model AuthSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  mfaVerifiedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,expiresAt])
}
model EmailToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
}
model PrayerDay {
  id String @id @default(cuid())
  venueId String
  venue Venue @relation(fields:[venueId],references:[id])
  localDate String
  fajr String
  sunrise String
  dhuhr String
  asr String
  maghrib String
  isha String
  fajrIqamah String?
  dhuhrIqamah String?
  asrIqamah String?
  maghribIqamah String?
  ishaIqamah String?
  source String @default("mosque")
  published Boolean @default(false)
  revision Int @default(1)
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([venueId,localDate])
  @@index([venueId,published,localDate])
}

// Immutable candidate values per venue/date and revision. An approved candidate
// is copied atomically to PrayerDay when published. Readers never see drafts.
model PrayerScheduleRevision {
  id String @id @default(cuid())
  venueId String
  venue Venue @relation(fields:[venueId],references:[id])
  localDate String
  revision Int
  baseRevision Int @default(0)
  fajr String
  sunrise String
  dhuhr String
  asr String
  maghrib String
  isha String
  fajrIqamah String?
  dhuhrIqamah String?
  asrIqamah String?
  maghribIqamah String?
  ishaIqamah String?
  source String
  correctionReason String?
  status String @default("draft")
  authoredById String
  approvedById String?
  submittedAt DateTime?
  approvedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([venueId,localDate,revision])
  @@index([venueId,status,localDate])
}

model JummahSession {
  id String @id @default(cuid())
  venueId String
  venue Venue @relation(fields:[venueId],references:[id])
  localDate String
  ordinal Int
  khutbahAt String?
  iqamahAt String
  language String?
  @@unique([venueId,localDate,ordinal])
}
model Announcement {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  body String
  kind String @default("general")
  status ContentStatus @default(draft)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,status,publishedAt])
}
model Event {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  description String
  location String
  startAt DateTime
  endAt DateTime
  capacity Int?
  rsvpCount Int @default(0)
  waitlistEnabled Boolean @default(false)
  status ContentStatus @default(draft)
  rsvps EventRSVP[]
  hostAssignments EventHostAssignment[]
  @@index([organizationId,status,startAt])
}
model EventRSVP {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  status String @default("confirmed")
  checkedInAt DateTime?
  checkedInById String?
  checkInRevision Int @default(0)
  createdAt DateTime @default(now())
  @@unique([eventId,userId])
  @@index([eventId,status,createdAt,id])
}
model EventHostAssignment {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
  hostId String
  host User @relation(fields:[hostId],references:[id],onDelete:Restrict)
  assignedById String
  assignedAt DateTime @default(now())
  revokedAt DateTime?
  @@unique([eventId,hostId])
  @@index([hostId,revokedAt])
}
model Circle {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  summary String
  cadence String
  guidelines String
  hostId String
  host User @relation("CircleHost",fields:[hostId],references:[id],onDelete:Restrict)
  status ContentStatus @default(draft)
  createdAt DateTime @default(now())
  members CircleMember[]
  updates CircleUpdate[]
  @@index([organizationId,status,createdAt])
  @@index([hostId,status])
}
model CircleMember {
  id String @id @default(cuid())
  circleId String
  circle Circle @relation(fields:[circleId],references:[id],onDelete:Cascade)
  userId String
  member User @relation(fields:[userId],references:[id],onDelete:Restrict)
  status CircleMemberStatus @default(requested)
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String?
  decisionReason String?
  updatedAt DateTime @updatedAt
  @@unique([circleId,userId])
  @@index([circleId,status,requestedAt,id])
  @@index([userId,status])
}
model CircleUpdate {
  id String @id @default(cuid())
  circleId String
  circle Circle @relation(fields:[circleId],references:[id],onDelete:Cascade)
  authorId String
  author User @relation("CircleUpdateAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  body String
  publishedAt DateTime @default(now())
  revision Int @default(1)
  @@index([circleId,publishedAt,id])
}
model SchoolProgram {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  description String
  published Boolean @default(false)
  classes ClassSection[]
  applications EnrollmentApplication[]
}
model ClassSection {
  id String @id @default(cuid())
  programId String
  program SchoolProgram @relation(fields:[programId],references:[id])
  name String
  schedule String
  capacity Int?
  teachers TeacherAssignment[]
  enrollments Enrollment[]
  waitlist SchoolWaitlist[]
  sessions ClassSession[]
  assignments SchoolAssignment[]
  reports StudentReport[]
}
model Student {
  id String @id @default(cuid())
  organizationId String?
  organization Organization? @relation(fields:[organizationId],references:[id])
  studentNumber String @unique
  firstName String
  lastName String
  userId String? @unique
  user User? @relation("StudentAccount",fields:[userId],references:[id])
  guardians GuardianLink[]
  enrollments Enrollment[]
  waitlist SchoolWaitlist[]
  attendance Attendance[]
  invoices SchoolInvoice[]
  submissions StudentSubmission[]
  reports StudentReport[]
  applications EnrollmentApplication[] @relation("ApplicationStudent")
  @@index([organizationId])
}
model GuardianLink {
  id String @id @default(cuid())
  guardianId String
  guardian User @relation(fields:[guardianId],references:[id])
  studentId String
  student Student @relation(fields:[studentId],references:[id])
  approvedAt DateTime?
  revokedAt DateTime?
  @@unique([guardianId,studentId])
}
model TeacherAssignment {
  id String @id @default(cuid())
  teacherId String
  teacher User @relation(fields:[teacherId],references:[id])
  classId String
  classSection ClassSection @relation(fields:[classId],references:[id])
  @@unique([teacherId,classId])
}
model Enrollment {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId],references:[id])
  classId String
  classSection ClassSection @relation(fields:[classId],references:[id])
  status String @default("active")
  @@unique([studentId,classId])
}
model SchoolWaitlist {
  id String @id @default(cuid())
  classId String
  classSection ClassSection @relation(fields:[classId],references:[id],onDelete:Restrict)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Restrict)
  status SchoolWaitlistStatus @default(waiting)
  requestedAt DateTime @default(now())
  decidedAt DateTime?
  decidedById String?
  decisionReason String?
  @@unique([classId,studentId])
  @@index([classId,status,requestedAt,id])
}
model ClassSession {
  id String @id @default(cuid())
  classId String
  classSection ClassSection @relation(fields:[classId],references:[id])
  startsAt DateTime
  attendance Attendance[]
  @@index([classId,startsAt])
}
model Attendance {
  id String @id @default(cuid())
  sessionId String
  session ClassSession @relation(fields:[sessionId],references:[id])
  studentId String
  student Student @relation(fields:[studentId],references:[id])
  markedById String
  status AttendanceStatus
  revision Int @default(1)
  // Existing marks retain NULL rather than an invented historic timestamp.
  markedAt DateTime?
  correctedAt DateTime?
  correctedById String?
  correctionReason String?
  @@unique([sessionId,studentId])
}
enum InvoiceStatus {
  pending
  paid
  void
  refunded
}
model SchoolInvoice {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  receipt PaymentReceipt? @relation("InvoiceReceipt")
  paymentIntentId String? @unique
  studentId String
  student Student @relation(fields:[studentId],references:[id])
  payerGuardianId String
  description String
  amountMinor Int
  currency String @default("usd")
  dueAt DateTime
  status InvoiceStatus @default(pending)
  stripeSessionId String? @unique
  paidAt DateTime?
  createdAt DateTime @default(now())
  @@index([studentId,status])
  @@index([payerGuardianId,status])
}
model DonationCampaign {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  purpose String
  goalMinor Int?
  currency String @default("usd")
  published Boolean @default(false)
  donations Donation[]
}
model Donation {
  id String @id @default(cuid())
  receipt PaymentReceipt? @relation("DonationReceipt")
  paymentIntentId String? @unique
  campaignId String
  campaign DonationCampaign @relation(fields:[campaignId],references:[id])
  donorId String
  donor User @relation(fields:[donorId],references:[id])
  amountMinor Int
  currency String @default("usd")
  anonymous Boolean @default(false)
  status PaymentStatus @default(pending)
  stripeSessionId String? @unique
  createdAt DateTime @default(now())
}
enum ProviderPayoutState {
  pending
  in_transit
  paid
  failed
  canceled
}
// A signed provider report is not a settlement reconciliation.
// Gross, processor fees, disputes and bank credit remain unknown until
// verified provider balance transactions and actual bank settlement are matched.
model ProviderPayout {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  providerPayoutId String @unique
  amountMinor Int
  currency String
  state ProviderPayoutState
  arrivalAt DateTime?
  failureCode String?
  lastProviderEventId String
  lastProviderEventCreated Int
  observedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes PayoutReviewNote[]
  @@index([organizationId,state,observedAt])
}
model PayoutReviewNote {
  id String @id @default(cuid())
  payoutId String
  payout ProviderPayout @relation(fields:[payoutId],references:[id],onDelete:Restrict)
  authorId String
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  body String
  createdAt DateTime @default(now())
  @@index([payoutId,createdAt])
}
model PaymentEvent {
  id String @id @default(cuid())
  providerEventId String @unique
  type String
  processedAt DateTime @default(now())
}
model VolunteerOpportunity {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  description String
  startsAt DateTime
  capacity Int
  filled Int @default(0)
  published Boolean @default(false)
  applications VolunteerApplication[]
  shifts VolunteerShift[]
}
model VolunteerApplication {
  id String @id @default(cuid())
  opportunityId String
  opportunity VolunteerOpportunity @relation(fields:[opportunityId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  status ApplicationStatus @default(submitted)
  shifts VolunteerShift[]
  @@unique([opportunityId,userId])
}
model Proposal {
  id String @id @default(cuid())
  submittedById String?
  submitter User? @relation("ProposalSubmitter",fields:[submittedById],references:[id])
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  description String
  status ContentStatus @default(draft)
  votes ProposalVote[]
}
model ProposalVote {
  id String @id @default(cuid())
  proposalId String
  proposal Proposal @relation(fields:[proposalId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  @@unique([proposalId,userId])
}
model JobPosting {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  description String
  company String
  status ContentStatus @default(draft)
  applications JobApplication[]
}
model JobApplication {
  id String @id @default(cuid())
  jobId String
  job JobPosting @relation(fields:[jobId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  coverLetter String
  status ApplicationStatus @default(submitted)
  reviewedAt DateTime?
  reviewerId String?
  @@unique([jobId,userId])
}
model RentalResource {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  title String
  description String
  published Boolean @default(false)
  bookings RentalBooking[]
}
model RentalBooking {
  id String @id @default(cuid())
  resourceId String
  resource RentalResource @relation(fields:[resourceId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  startAt DateTime
  endAt DateTime
  status BookingStatus @default(requested)
  @@index([resourceId,startAt,endAt])
}
model Notification {
  id String @id @default(cuid())
  // Nullable only for legacy unsafely unowned notifications, which remain
  // hidden and undeliverable until individually reviewed by privacy staff.
  organizationId String?
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  userId String
  user User @relation(fields:[userId],references:[id])
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  outboxEvents OutboxEvent[]
  @@index([organizationId,userId,createdAt])
  @@index([userId,organizationId,readAt])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields:[actorId],references:[id])
  action String
  entity String
  entityId String
  detail String?
  occurredAt DateTime @default(now())
  @@index([actorId,occurredAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,expiresAt])
}
model AuthThrottle {
  keyHash String @id
  failures Int @default(0)
  blockedUntil DateTime?
  updatedAt DateTime @updatedAt
}

model SchoolAssignment {
  id String @id @default(cuid())
  classId String
  classSection ClassSection @relation(fields:[classId],references:[id])
  teacherId String
  author User @relation("AssignmentAuthor",fields:[teacherId],references:[id])
  title String
  instructions String
  dueAt DateTime
  published Boolean @default(false)
  createdAt DateTime @default(now())
  submissions StudentSubmission[]
  @@index([classId,published,dueAt])
}
model StudentSubmission {
  id String @id @default(cuid())
  assignmentId String
  assignment SchoolAssignment @relation(fields:[assignmentId],references:[id])
  studentId String
  student Student @relation(fields:[studentId],references:[id])
  body String
  submittedAt DateTime @default(now())
  @@unique([assignmentId,studentId])
}
model StudentReport {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId],references:[id])
  classId String
  classSection ClassSection @relation(fields:[classId],references:[id])
  teacherId String
  teacher User @relation("ReportAuthor",fields:[teacherId],references:[id])
  summary String
  status ContentStatus @default(draft)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([studentId,status,publishedAt])
}

enum ContactStatus {
  new
  in_review
  closed
}
enum CareCaseStatus {
  submitted
  in_review
  closed
}
enum CareAccessStatus {
  proposed
  approved
  revoked
}
model CareRequest {
  id String @id @default(cuid())
  reference String @unique
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  requesterId String
  requester User @relation("CareRequester",fields:[requesterId],references:[id],onDelete:Restrict)
  // Authenticated ciphertext only; no plaintext, category, or sensitive message in email.
  encryptedMessage String
  consentVersion String
  consentedAt DateTime
  status CareCaseStatus @default(submitted)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?
  retentionAt DateTime
  access CareCaseAccess[]
  @@index([organizationId,status,createdAt])
  @@index([requesterId,organizationId,createdAt])
}
model CareCaseAccess {
  id String @id @default(cuid())
  caseId String
  careCase CareRequest @relation(fields:[caseId],references:[id],onDelete:Restrict)
  assigneeId String
  assignee User @relation("CareAssignee",fields:[assigneeId],references:[id],onDelete:Restrict)
  proposedById String
  approvedById String?
  reason String
  status CareAccessStatus @default(proposed)
  createdAt DateTime @default(now())
  approvedAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  @@unique([caseId,assigneeId])
  @@index([caseId,status,expiresAt])
  @@index([assigneeId,status,expiresAt])
}
model ContactSubmission {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  name String
  email String
  subject String
  message String
  status ContactStatus @default(new)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([organizationId,status,createdAt])
  @@index([email,createdAt])
}

enum ExpenseStatus {
  pending
  approved
  rejected
}
model FinanceBudget {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  category String
  periodMonth String
  amountMinor Int
  currency String @default("usd")
  published Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([organizationId,category,periodMonth])
}
model FinanceExpense {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  description String
  category String
  amountMinor Int
  currency String @default("usd")
  incurredOn DateTime
  status ExpenseStatus @default(pending)
  submittedById String
  submitter User @relation("ExpenseSubmitter",fields:[submittedById],references:[id])
  approvedById String?
  approver User? @relation("ExpenseApprover",fields:[approvedById],references:[id])
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,status,createdAt])
}

model EnrollmentApplication {
  id String @id @default(cuid())
  organizationId String
  programId String
  program SchoolProgram @relation(fields:[programId],references:[id])
  applicantUserId String
  applicant User @relation("ApplicationParent",fields:[applicantUserId],references:[id])
  studentFirstName String
  studentLastName String
  notes String?
  // Applicant's own acknowledgement of review conditions, not proof of custody.
  reviewAcknowledgedAt DateTime?
  reviewAcknowledgementVersion String?
  status ApplicationStatus @default(submitted)
  reviewedById String?
  reviewer User? @relation("ApplicationReviewer",fields:[reviewedById],references:[id])
  approvedStudentId String?
  approvedStudent Student? @relation("ApplicationStudent",fields:[approvedStudentId],references:[id])
  decisionReason String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([organizationId,status,createdAt])
  @@index([applicantUserId,createdAt])
}

model UserPreference {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  newsletterOptIn Boolean @default(false)
  eventEmailOptIn Boolean @default(false)
  quietHoursEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}
enum DeletionStatus {
  pending
  in_review
  rejected
}
model DeletionRequest {
  id String @id @default(cuid())
  organizationId String?
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull)
  userId String
  user User @relation("DeletionSubject",fields:[userId],references:[id])
  status DeletionStatus @default(pending)
  reason String?
  reviewedById String?
  reviewer User? @relation("DeletionReviewer",fields:[reviewedById],references:[id])
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,status])
  @@index([organizationId,status,createdAt])
}

