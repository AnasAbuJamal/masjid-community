# Copy this file to staff-web/.env.local for local development.
# Never commit real credentials. Configure Vercel secrets in its dashboard.
# Prisma datasource uses PostgreSQL, NOT MongoDB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/masjid_community?sslmode=require"

# Required: random string at least 32 characters (openssl rand -base64 48).
AUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional features: configure your actual Stripe dashboard credentials.
# Do not mix sandbox and production keys.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email verification requires a verified Resend sender / API key.
RESEND_API_KEY=""
EMAIL_FROM=""

# Do not set demo seed passwords or run demo seed scripts on production.
# Production administrator provisioning must be done deliberately.
