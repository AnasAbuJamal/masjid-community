NEXT_PUBLIC_APP_URL="http://localhost:3000"
MASJID_TIME_ZONE="America/New_York"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""
# Optional: configure before enabling online donations.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional: email provider used by lib/email.ts.
RESEND_API_KEY=""
